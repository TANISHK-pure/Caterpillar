<?xml version="1.0"?>
<sdf version="1.10">
  <model name="truck_400t">
    <self_collide>false</self_collide>
    <link name="chassis">
      <pose>0 0 4.100 0 0 0</pose>
      <inertial><mass>60750</mass><inertia><ixx>536625</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1265625</iyy><iyz>0</iyz><izz>1549125</izz></inertia></inertial>
      <visual name="body"><geometry><box><size>15.0 9.0 5.0</size></box></geometry>
        <material><ambient>0.468 0.110 0.110 1</ambient><diffuse>0.850 0.200 0.200 1</diffuse></material></visual>
      <collision name="body_c"><geometry><box><size>15.0 9.0 5.0</size></box></geometry></collision>
      <visual name="cab"><pose>4.750 0 4.000 0 0 0</pose>
        <geometry><box><size>3.5 7.0 3.0</size></box></geometry>
        <material><ambient>0.22 0.22 0.22 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material></visual>
      <visual name="lidar_post"><pose>4.750 0 5.750 0 0 0</pose>
        <geometry><cylinder><radius>0.12</radius><length>0.5</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
      <sensor name="lidar" type="gpu_lidar"><pose>4.750 0 6.000 0 0 0</pose>
        <topic>/truck_400t/scan</topic><update_rate>10</update_rate><always_on>1</always_on><visualize>false</visualize>
        <ray><scan>
          <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal>
          <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
        </scan><range><min>0.5</min><max>50.0</max><resolution>0.05</resolution></range></ray>
      </sensor>
    </link>
    <!-- Wheel ixx/iyy/izz are solid-cylinder values for THIS wheel's own
         mass/radius/length (izz=0.5*m*r^2, ixx=iyy=m*(3r^2+L^2)/12).
         Previously copy-pasted from truck_100t's much smaller wheel
         (r=1.0 vs 1.6 here), under-stating rotational inertia by ~3.2x --
         the worst mismatch of the 3 trucks, tracking with T3 being the
         most frequent/severe victim of the wheel-spins-but-chassis-
         doesn't-move freeze (confirmed via joint_state telemetry). -->
    <link name="wheel_fl">
      <pose>6.000 5.200 1.600 -1.5708 0 0</pose>
      <inertial><mass>500</mass><inertia><ixx>380.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>380.0</iyy><iyz>0</iyz><izz>640</izz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <surface><friction><ode><mu>2.8</mu><mu2>2.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_fr">
      <pose>6.000 -5.200 1.600 -1.5708 0 0</pose>
      <inertial><mass>500</mass><inertia><ixx>380.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>380.0</iyy><iyz>0</iyz><izz>640</izz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <surface><friction><ode><mu>2.8</mu><mu2>2.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_rl">
      <pose>-6.000 5.200 1.600 -1.5708 0 0</pose>
      <inertial><mass>500</mass><inertia><ixx>380.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>380.0</iyy><iyz>0</iyz><izz>640</izz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <surface><friction><ode><mu>2.8</mu><mu2>2.8</mu2></ode></friction></surface></collision>
    </link>
    <link name="wheel_rr">
      <pose>-6.000 -5.200 1.600 -1.5708 0 0</pose>
      <inertial><mass>500</mass><inertia><ixx>380.0</ixx><ixy>0</ixy><ixz>0</ixz><iyy>380.0</iyy><iyz>0</iyz><izz>640</izz></inertia></inertial>
      <visual name="v"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>1.6</radius><length>1.2</length></cylinder></geometry>
        <surface><friction><ode><mu>2.8</mu><mu2>2.8</mu2></ode></friction></surface></collision>
    </link>
    <joint name="wheel_fl_joint" type="revolute">
      <parent>chassis</parent><child>wheel_fl</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>1e7</effort><velocity>50</velocity></limit>
        <dynamics><friction>0.05</friction></dynamics></axis>
    </joint>
    <joint name="wheel_fr_joint" type="revolute">
      <parent>chassis</parent><child>wheel_fr</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>1e7</effort><velocity>50</velocity></limit>
        <dynamics><friction>0.05</friction></dynamics></axis>
    </joint>
    <joint name="wheel_rl_joint" type="revolute">
      <parent>chassis</parent><child>wheel_rl</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>1e7</effort><velocity>50</velocity></limit>
        <dynamics><friction>0.05</friction></dynamics></axis>
    </joint>
    <joint name="wheel_rr_joint" type="revolute">
      <parent>chassis</parent><child>wheel_rr</child>
      <axis><xyz expressed_in="__model__">0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>1e7</effort><velocity>50</velocity></limit>
        <dynamics><friction>0.05</friction></dynamics></axis>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint><left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint><right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>10.400</wheel_separation><wheel_radius>1.6</wheel_radius>
      <odom_topic>/truck_400t/odometry</odom_topic><tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration><max_angular_acceleration>1.0</max_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose><publish_model_pose>true</publish_model_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose><update_frequency>10</update_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </model>
</sdf>
